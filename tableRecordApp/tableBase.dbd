
    field(INP,DBF_INLINK) {
        prompt("Input Specification")
        promptgroup("40 - Input")
        interest(1)
    }
    field(NUMCOLS, DBF_ULONG) {
        prompt("Number of active columns (set by device support)")
        special(SPC_NOMOD)
        interest(1)
    }
    field(MAXROWS, DBF_ULONG) {
        prompt("Max number of rows per column")
        special(SPC_NOMOD)
        interest(1)
        initial("1")
    }
    field(RPVT, DBF_NOACCESS) {
        prompt("Record Private")
        special(SPC_NOMOD)
        extra("void *rpvt")
        interest(4)
    }

